# ==============================================================================
# TeleFlow Pro — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# For Cloudflare Workers production:
#   Set non-secrets in `wrangler.toml` [vars] and secrets via:
#   npx wrangler secret put NUXT_ENCRYPTION_KEY
#   npx wrangler secret put NUXT_WEBHOOK_SECRET
#   npx wrangler secret put NUXT_TELEGRAM_BOT_TOKEN
#   npx wrangler secret put NUXT_GEMINI_API_KEY
# ==============================================================================

# ------------------------------------------------------------------------------
# Security & Encryption (REQUIRED)
# ------------------------------------------------------------------------------
# 32+ character secret key used for AES-256 token encryption and password hashing.
# You can generate one with: openssl rand -base64 32
ENCRYPTION_KEY=teleflow-ultra-secure-secret-encryption-key-32b

# ------------------------------------------------------------------------------
# Telegram Bot Configuration
# ------------------------------------------------------------------------------
# Your Telegram bot token obtained from @BotFather.
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=

# Default Telegram Group or Channel Chat ID (e.g., -1001234567890).
# Leave empty if configuring targets directly inside the dashboard.
TELEGRAM_GROUP_CHAT_ID=

# Secret token verified in Telegram webhook header X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=teleflow-webhook-secret-token

# Public URL of this deployment (used to register Telegram webhook).
# e.g., https://your-worker-subdomain.workers.dev or https://bot.yourdomain.com
PUBLIC_URL=

# ------------------------------------------------------------------------------
# Google Gemini AI Integration
# ------------------------------------------------------------------------------
# API Key from Google AI Studio (https://aistudio.google.com/)
# Used for intelligent auto-replies when bot is mentioned in group chats.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Server & Runtime Configuration (Local Dev / Docker)
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
